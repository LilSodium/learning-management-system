<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CLI.LMS.MAUI.StudentEditPage"
             Title="Edit Student">

    <VerticalStackLayout Padding="24" Spacing="16">

        <Label x:Name="TitleLabel" Style="{StaticResource PageTitle}" />

        <VerticalStackLayout Spacing="6">
            <Label Text="Full name" Style="{StaticResource Caption}" />
            <Entry x:Name="NameEntry" Placeholder="Full name" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Text="Student code" Style="{StaticResource Caption}" />
            <Entry x:Name="CodeEntry" Placeholder="Student code" />
        </VerticalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Text="Classification" Style="{StaticResource Caption}" />
            <Picker x:Name="ClassificationPicker" Title="Classification" />
        </VerticalStackLayout>

        <HorizontalStackLayout Spacing="12" Margin="0,8,0,0">
            <Button Text="Save" Clicked="OnSaveClicked" />
            <Button Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnCancelClicked" />
        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>
