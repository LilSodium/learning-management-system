<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CLI.LMS.MAUI.OutboxPage"
             Title="Email Log">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="12">

        <Label Grid.Row="0" Text="Email Log" Style="{StaticResource PageTitle}" />
        <Label Grid.Row="1"
               Text="Emails sent to students when an assignment is posted."
               Style="{StaticResource Caption}" />

        <CollectionView Grid.Row="2" x:Name="EmailList" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No emails sent yet. Post an assignment to notify enrolled students."
                       Style="{StaticResource Caption}"
                       HorizontalOptions="Center"
                       Margin="0,24,0,0" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,4">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Subject}" FontAttributes="Bold" FontSize="15" />
                            <Label Style="{StaticResource Caption}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="To: " FontAttributes="Bold" />
                                        <Span Text="{Binding To}" />
                                        <Span Text="   |   " />
                                        <Span Text="{Binding SentAt, StringFormat='{0:g}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding Body}" FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
