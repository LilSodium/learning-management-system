<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CLI.LMS.MAUI.CourseDetailPage"
             Title="Course">

    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">

        <!-- Announcement banner (theme-aware) -->
        <Border x:Name="AnnouncementFrame"
                Grid.Row="0"
                Padding="14"
                StrokeShape="RoundRectangle 8"
                Stroke="#F1D58B"
                BackgroundColor="{AppThemeBinding Light={StaticResource AnnouncementBgLight}, Dark={StaticResource AnnouncementBgDark}}"
                IsVisible="True">
            <VerticalStackLayout Spacing="2">
                <Label Text="Announcement" FontSize="12" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
                <Label x:Name="AnnouncementLabel" FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
            </VerticalStackLayout>
        </Border>

        <Label x:Name="TitleLabel"
               Grid.Row="1"
               Style="{StaticResource PageTitle}"
               Margin="0,4,0,0" />

        <Label x:Name="DescriptionLabel"
               Grid.Row="2"
               Style="{StaticResource Caption}"
               FontSize="14" />

        <Border x:Name="GradeCard"
                Grid.Row="3"
                Style="{StaticResource Card}"
                Padding="14,8"
                HorizontalOptions="Start"
                Margin="0,4,0,4">
            <Label x:Name="GradeLabel"
                   FontSize="15"
                   FontAttributes="Bold" />
        </Border>

        <ScrollView Grid.Row="4">
            <VerticalStackLayout x:Name="SectionsContainer" Spacing="12" />
        </ScrollView>

    </Grid>

</ContentPage>
